#!/usr/bin/env python3
"""patches/golden-gate-hd4000-planes/build/make OUTPUT_PARENT

Builds libhd4000-planes.dylib (x86_64, ad hoc signed) from hd4000_planes.m into a new artifact folder
OUTPUT_PARENT/hd4000-planes-YYYYMMDD-<source sha256 12> with build.json (source and output sha256, compiler, flags).
Compiles from this folder with the source named relatively, so the same source and compiler give the same bytes
(the r1 artifact, fee66603..., was reproduced this way). Run with `python3.14 -I`.
"""
import datetime
import hashlib
import json
import pathlib
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
SOURCE = 'hd4000_planes.m'
INSTALL_NAME = '/usr/lib/libhd4000-planes.dylib'
CFLAGS = ['-arch', 'x86_64', '-mmacosx-version-min=13.0', '-fobjc-arc', '-Wall', '-Wextra', '-Werror']
FRAMEWORKS = ['Foundation', 'Metal', 'IOSurface']


def sha256(path):
    return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()


def run(cmd, **kw):
    return subprocess.run(cmd, check=True, capture_output=True, text=True, **kw)


def build(out_dir):
    """compile and sign into OUT_DIR/libhd4000-planes.dylib; returns its path"""
    out = pathlib.Path(out_dir) / 'libhd4000-planes.dylib'
    cmd = ['xcrun', 'clang', *CFLAGS, *[a for f in FRAMEWORKS for a in ('-framework', f)], '-dynamiclib',
           '-install_name', INSTALL_NAME, '-o', str(out), SOURCE]
    run(cmd, cwd=HERE)
    run(['codesign', '-s', '-', '-f', str(out)])
    return out, [out.name if c == str(out) else c for c in cmd]   # recorded without the local folder


def main(parent):
    src = sha256(HERE / SOURCE)
    dest = pathlib.Path(parent).resolve() / f'hd4000-planes-{datetime.date.today():%Y%m%d}-{src[:12]}'
    if dest.exists():
        sys.exit(f'{dest} exists; refusing to overwrite')
    dest.mkdir(parents=True)
    out, cmd = build(dest)
    record = dict(unit='patches/golden-gate-hd4000-planes/build', source=SOURCE, source_sha256=src,
                  output='libhd4000-planes.dylib', output_sha256=sha256(out), install_name=INSTALL_NAME,
                  compiler=run(['xcrun', 'clang', '--version']).stdout.splitlines()[0], command=cmd,
                  date=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'))
    (dest / 'build.json').write_text(json.dumps(record, indent=2) + '\n')
    print(dest)
    print(record['output_sha256'], 'libhd4000-planes.dylib')


if __name__ == '__main__':
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    main(sys.argv[1])
