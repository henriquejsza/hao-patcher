#!/usr/bin/env python3
"""build-tools: the helper tools a user's Mac needs to make its rows, built once here and published as our assets, so
the user's Mac needs no compiler and no git checkout (VM-free primary build, step 1).

  build-tools ripatch NEW_DIR                       NEW_DIR/ripatch: pipeline/unpack/ripatch.c as one universal
                                                    (arm64 + x86_64) binary, signed ad hoc; donor-inputs --ripatch uses it
  build-tools oclp-source NEW_DIR --commit C [--repo R]
                                                    NEW_DIR/oclp-source.tar: `git archive` of OpenCore Legacy Patcher at
                                                    C (default repository: store/oclp), with its LICENSE.txt beside it
                                                    (BSD 3-clause); the builder reads OCLP's support code from it

Each NEW_DIR gets build.json: the producing hao-patcher commit and whether the checkout was clean, the inputs' sha256,
and the tool versions. Run from a clean checkout for a release (release-cut refuses a dirty record).
"""
import datetime
import hashlib
import json
import subprocess
import sys
from pathlib import Path

TOP = Path(__file__).resolve().parents[2]


def sha256(p):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for b in iter(lambda: f.read(1 << 20), b''):
            h.update(b)
    return h.hexdigest()


def source():
    commit = subprocess.run(['git', '-C', str(TOP), 'rev-parse', 'HEAD'], capture_output=True, text=True,
                            check=True).stdout.strip()
    dirty = bool(subprocess.run(['git', '-C', str(TOP), 'status', '--porcelain', '--untracked-files=no'],
                                capture_output=True, text=True, check=True).stdout.strip())
    return commit, dirty


def new_dir(path):
    path = Path(path)
    path.mkdir(parents=True)          # new: an artifact folder is never written over
    return path


def record(out, unit, inputs, tools, files):
    commit, dirty = source()
    (out / 'build.json').write_text(json.dumps({
        'unit': unit, 'commit': commit, 'dirty': dirty,
        'date': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'),
        'inputs': inputs, 'tools': tools, 'files': {f: sha256(out / f) for f in files}}, indent=1) + '\n')


def ripatch(out):
    out = new_dir(out)
    src = TOP / 'pipeline' / 'unpack' / 'ripatch.c'
    exe = out / 'ripatch'
    subprocess.run(['/usr/bin/cc', '-O2', '-Wall', '-arch', 'arm64', '-arch', 'x86_64', '-mmacosx-version-min=12.0',
                    '-o', str(exe), str(src)], check=True)
    subprocess.run(['codesign', '-f', '-s', '-', str(exe)], check=True, capture_output=True)
    cc = subprocess.run(['/usr/bin/cc', '--version'], capture_output=True, text=True).stdout.splitlines()[0]
    record(out, 'pipeline/unpack/build-tools ripatch', {'pipeline/unpack/ripatch.c': sha256(src)}, {'cc': cc},
           ['ripatch'])
    return exe


def oclp_source(out, commit, repo):
    repo = Path(repo)
    full = subprocess.run(['git', '-C', str(repo), 'rev-parse', '--verify', commit + '^{commit}'], capture_output=True,
                          text=True, check=True).stdout.strip()
    out = new_dir(out)
    with open(out / 'oclp-source.tar', 'wb') as f:
        subprocess.run(['git', '-C', str(repo), 'archive', '--format=tar', full], stdout=f, check=True)
    (out / 'LICENSE.txt').write_bytes(subprocess.run(['git', '-C', str(repo), 'show', full + ':LICENSE.txt'],
                                                     capture_output=True, check=True).stdout)
    git = subprocess.run(['git', '--version'], capture_output=True, text=True).stdout.strip()
    record(out, 'pipeline/unpack/build-tools oclp-source', {'oclp_commit': full}, {'git': git},
           ['oclp-source.tar', 'LICENSE.txt'])
    return out / 'oclp-source.tar'


def main(argv):
    if len(argv) == 2 and argv[0] == 'ripatch':
        print(ripatch(argv[1]))
        return 0
    if len(argv) >= 4 and argv[0] == 'oclp-source' and argv[2] == '--commit':
        repo = argv[argv.index('--repo') + 1] if '--repo' in argv else TOP / 'store' / 'oclp'
        print(oclp_source(argv[1], argv[3], repo))
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
