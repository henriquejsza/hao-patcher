#!/usr/bin/env python3
"""Build one release asset of hao-patcher from this checkout and compare it with its input row.

  asset-build list
  asset-build ROW OUT [--hao-runtime CHECKOUT] [--oclp-upstream URL_OR_CLONE]

Writes the asset to OUT (a new folder; a file asset is OUT/NAME), then prints `SHA256 ROW` with the sha256 the row
defines (pipeline/lock.py, so a `# hash:` line applies) and exits 1 when it is not the row's. Needs Xcode
(xcrun clang, codesign). codeid_carrier also needs a clean hao-runtime checkout at the commit below; oclp_source
clones upstream OCLP from GitHub unless --oclp-upstream names a clone.
"""
import argparse
import glob
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import tempfile

TOP = Path(__file__).resolve().parents[2]
LOCKS = ('pipeline/inputs/golden/26B131', 'pipeline/inputs/25G342', 'pipeline/inputs/common')
HAO_RUNTIME_CODEID = '33a0a0404d3f5c3008c79e295026ea99bee563eb'
PY = [sys.executable, '-I']


def run(*args):
    subprocess.run([str(a) for a in args], cwd=TOP, check=True, stdout=subprocess.DEVNULL)


def one(pattern):
    found = glob.glob(str(pattern))
    if len(found) != 1:
        sys.exit('asset-build: expected one %s, found %d' % (pattern, len(found)))
    return Path(found[0])


def compiled(make):
    """A Wi-Fi compat library: the make's own build() (compile and sign); its coverage pass needs Apple files."""
    def build(tmp, out, args):
        return runpy.run_path(str(TOP/make))['build'](tmp)
    return build


def made(make, pattern):
    """A producer that writes PARENT/<name>-.../FILE."""
    def build(tmp, out, args):
        run(*PY, make, tmp)
        return one(Path(tmp)/pattern)
    return build


def dss(tmp, out, args):
    run(*PY, 'tools/display-state-shim/display-state-shim', '--out', Path(tmp)/'a')
    return Path(tmp)/'a/dss_shim.dylib'


def slice_guard(tmp, out, args):
    run(*PY, 'patches/golden-gate-appstore-slices/build/make', tmp)
    out.mkdir()
    shutil.copy(one(Path(tmp)/'appstore-slices-*/hao-slice-guard'), out/'hao-slice-guard')
    return out


def store(tmp, out, args):
    out.mkdir()
    runpy.run_path(str(TOP/'tools/appstore-policy/prepare.py'))['compile_library'](out/'libhao-appstore-policy.dylib')
    return out


def codeid(tmp, out, args):
    if not args.hao_runtime:
        sys.exit('asset-build: codeid_carrier needs --hao-runtime CHECKOUT (hao-runtime %s)' % HAO_RUNTIME_CODEID)
    head = subprocess.run(['git', '-C', str(args.hao_runtime), 'rev-parse', 'HEAD'], capture_output=True, text=True)
    if head.stdout.strip() != HAO_RUNTIME_CODEID:
        sys.exit('asset-build: %s is not hao-runtime %s' % (args.hao_runtime, HAO_RUNTIME_CODEID))
    run(*PY, 'patches/golden-gate-userspace/src/codeid/make', tmp, '--hao-runtime', args.hao_runtime)
    shutil.copytree(one(Path(tmp)/'codeid-carrier-*'), out)
    return out


def tool(*argv, name):
    """A pipeline/unpack producer that writes NEW_DIR/NAME and its build.json."""
    def build(tmp, out, args):
        extra = ['--upstream', args.oclp_upstream] if args.oclp_upstream and argv[-1] == 'oclp-source-rebuild' else []
        run(*PY, *argv, Path(tmp)/'a', *extra)
        return Path(tmp)/'a'/name
    return build


ASSETS = {
    'display_state_shim': dss,
    'io80211_compat': compiled('patches/golden-gate-userspace/src/io80211/make'),
    'wifip2p_compat': compiled('patches/golden-gate-userspace/src/wifip2p/make'),
    'corewifi_compat': compiled('patches/golden-gate-userspace/src/corewifi/make'),
    'windowserver_filter_shim': made('patches/golden-gate-windowserver-filter/make',
                                     'windowserver-filter-*/windowserver_filter.dylib'),
    'corespotlight_compat_shim': made('patches/golden-gate-corespotlight-compat/make',
                                      'corespotlight-compat-*/corespotlight_compat.dylib'),
    'codeid_carrier': codeid,
    'store_service': store,
    'appstore_slice_guard': slice_guard,
    'fl': tool('pipeline/unpack/pristine-tools/build-fl', name='fl'),
    'ripatch': tool('pipeline/unpack/build-tools', 'ripatch', name='ripatch'),
    'oclp_source': tool('pipeline/unpack/build-tools', 'oclp-source-rebuild', name='oclp-source.tar'),
}


def lock_of(row):
    for lock in LOCKS:
        if (TOP/lock/row).is_file():
            return str(TOP/lock)
    sys.exit('asset-build: no row %s in %s' % (row, ', '.join(LOCKS)))


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('row')
    p.add_argument('out', type=Path, nargs='?')
    p.add_argument('--hao-runtime', type=Path)
    p.add_argument('--oclp-upstream', help='oclp_source: an OCLP clone or URL instead of GitHub')
    args = p.parse_args(argv)
    if args.row == 'list':
        print('\n'.join(ASSETS))
        return 0
    if args.row not in ASSETS or args.out is None:
        p.error('ROW is one of: %s; OUT is required' % ', '.join(ASSETS))
    out = args.out.resolve()
    if out.exists():
        p.error('%s exists' % out)
    lock = lock_of(args.row)
    L = runpy.run_path(str(TOP/'pipeline/lock.py'))
    want, path = L['rows'](lock)[args.row]
    with tempfile.TemporaryDirectory(prefix='asset-build-') as tmp:
        built = ASSETS[args.row](tmp, out, args)
        if built != out:
            out.mkdir(parents=True)
            shutil.copyfile(built, out/os.path.basename(path))
            built = out/os.path.basename(path)
    got = L['row_hash'](lock, args.row, str(built))
    print('%s %s' % (got, args.row))
    if got != want:
        print('asset-build: %s is %s, the row says %s' % (args.row, got, want), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
