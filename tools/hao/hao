def _snap(s):
    return s if isinstance(s, str) or s is None else s.get('name')


def printer(level):
    s = CON.Style(level != 'json' and CON.colour_for(sys.stdout))      # the console palette (src/console.py)
    ok = s('ok', '✓' if 'utf' in (getattr(sys.stdout, 'encoding', None) or 'utf-8').lower() else 'ok')

    def emit(ev):
        k = ev['ev']
        if level == 'json':
            print(json.dumps(ev), flush=True)
            return
        if k == 'warning':
            print(CON.Style(CON.colour_for(sys.stderr))('warn', 'warning:') + ' ' + ev['text'], file=sys.stderr,
                  flush=True)
            return
        if level == 'quiet' and k not in ('done', 'reverted'):
            return
        if k == 'plan':
            print('%d to write, %d to set attributes on, %d already current' % (ev['write'], ev.get('attrs', 0),
                                                                                ev['same']))
            if ev.get('folders'):
                print('%d folders to create' % ev['folders'])
            if ev['needs_recovery']:
                print('%s (installer-only packs, not applied live): %s' % (
                    s('warn', 'needs Recovery'), ', '.join(s('bold', x) for x in ev['needs_recovery'])))
            for f in ev.get('needs_recovery_files', []):
                print('  %-6s %s %s  %s' % ('later', s('bold', '%-22s' % f['pack']), f['path'], s('dim', '(%s)' % f['reason'])))
        elif k == 'live':
            print('live: System %s, Data %s, booted %s (sealed: %s)' % (ev['system'], ev['data'], ev['booted'],
                                                                         ev['sealed']))
        elif k == 'mount':
            print('mounted %s read-write at %s' % (ev['device'], ev['point']))
        elif k == 'snapshot':
            print({'pre': 'named snapshot %s taken before writing', 'boot': 'next boot: new snapshot %s',
                   'root-to': 'next boot: snapshot %s'}[ev['kind']] % ev['name'])
        elif k == 'file.write':
            print('  %-6s %s %s' % ('new' if ev['new'] else 'write', s('bold', '%-22s' % ev['pack']), ev['path']))
            if level == 'show':
                print('         ' + s('dim', '%s -> %s' % ((ev['old_sha256'] or 'none')[:16], ev['sha256'][:16])))
        elif k == 'file.attrs':
            print('  %-6s %s %s  %s' % ('attrs', s('bold', '%-22s' % ev['pack']), ev['path'],
                                        s('dim', '(%s)' % ', '.join(ev['keys']))))
        elif k == 'file.revert':
            print('  %-6s %s' % ('remove' if ev['removed'] else 'attrs' if ev.get('attrs_only') else 'restore',
                                 ev['path']))
        elif k == 'rolled-back':
            print('%s %s: %d files put back (%s)' % (s('bad', 'rolled back'), ev['id'], ev['files'], ev['error']))
        elif k == 'restart':
            who = 'pid %s %s' % (ev['pid'], ev['command']) if ev['kind'] == 'process' else \
                  'launchd %s/%s' % (ev['domain'], ev['label'])
            print('  %-7s %s uses %s' % ('reboot' if ev['when'] == 'reboot' else 'restart', who, ev['path']))
        elif k == 'deferred':
            if level == 'show' or ev['status'] != 'needs-recovery' or ev['stale']:
                print('  %-14s %s  (%s)%s' % (ev['status'], ev['path'], ev['reason'],
                                              ' stale: made from the installed files' if ev['stale'] else ''))
        elif k == 'done':
            if ev['id'] is None:
                print('%s nothing to do: %d files already current' % (ok, ev['same']))
                return
            print('%s applied %s: %d written, %d attributes set, %d unchanged%s' % (
                ok, s('bold', ev['id']), ev['written'], ev.get('attrs', 0), ev['same'],
                ', snapshot ' + _snap(ev['snapshot']) if _snap(ev['snapshot']) else ''))
            if ev.get('not_set'):
                print(s('warn', 'not root:') + ' owners and system flags of %d files were not set (see the record)'
                      % ev['not_set'])
            if ev.get('reboot'):
                print('reboot to run it; undo: ' + s('bold', 'sudo hao patch --revert --live --i-have-a-backup'))
            else:
                print('undo: ' + s('bold', 'hao patch --revert --root ROOT --id %s' % ev['id']))
        elif k == 'reverted':
            print('%s reverted %s: %d files%s' % (ok, s('bold', ev['id']), ev['files'],
                                               '; reboot to run snapshot %s' % ev['snapshot'] if ev.get('reboot') else ''))
    return emit


def print_probe(r, level):
    if level == 'json':
        print(json.dumps(r, indent=1, default=str))
        return
    f = r['facts']
    print('machine %s, euid %d, csr %s, authenticated root %s, boot %s' % (
        r['machine'], r['euid'], 'unknown' if r['csr'] is None else '0x%x' % r['csr'], r['authenticated_root'],
        r['boot']))
    print('booted: %s (%s) from %s, sealed: %s' % (f['booted'].get('name'), f['booted'].get('uuid'),
                                                   f.get('root_device'), f.get('sealed')))
    if f.get('system'):
        print('System volume: %s "%s"; Data volume: %s at %s' % (f['system']['device'], f['system']['name'],
                                                               (f.get('data') or {}).get('device'),
                                                               (f.get('data') or {}).get('mount')))
    for m in f.get('system_mounts', []):
        print('System volume mounted at %s (%s)' % (m['point'], ', '.join(m['options'])))
    print('snapshots of the System volume:')
    for s in f.get('snapshots', []):
        print('  %s %-60s xid %s%s' % ('*' if s.get('booted') else ' ', s['name'], s['xid'],
                                       ', RootTo' if s.get('root_to') else ''))
    for rec in r['records']:
        print('hao %s %s, snapshot %s (booted before: %s)' % (rec['id'], rec['state'], rec['snapshot'],
                                                            rec['booted_before']))
    for s in r['steps']:
        print('%-4s %s: %s' % ('ok' if s['ok'] else 'NO', s['step'], s['why']))
    print('live patch would %s' % ('run' if r['ok'] else 'be refused'))


def deferred_entries(a):
    path = Path(a.deferred) if a.deferred else None
    if path is None and a.overlays:
        parents = {Path(o).resolve().parent for o in a.overlays}
        if len(parents) == 1 and (parents.pop() / 'deferred.json').is_file():
            path = Path(a.overlays[0]).resolve().parent / 'deferred.json'
    return json.loads(path.read_text()) if path else []


def cmd_patch(a):
    level = 'json' if a.log == 'json' else 'quiet' if a.quiet else 'show' if a.show else 'steps'
    try:
        if a.probe:
            r = MAC.probe(MAC.SystemHost(), a.state or MAC.STATE, a.mount_point)
            print_probe(r, level)
            return 0 if r['ok'] else 3
        if a.live and a.root:
            print('hao: --live patches the running system; --root is for a folder', file=sys.stderr)
            return 2
        root = Path('/') if a.live else Path(a.root) if a.root else None
        state = Path(a.state) if a.state else Path(MAC.STATE) if a.live else (root / 'private/var/db/hao' if root
                                                                                else None)
        if a.list:
            for r in LP.records(state):
                print('%-22s %-11s %3d files  packs %s%s' % (r['id'], r['state'], len(r['files']), ', '.join(r['packs']),
                                                            '  snapshot ' + r['snapshot'] if r.get('snapshot') else ''))
            return 0
        if root is None:
            print('hao: --root (a folder) or --live (this Mac) is required', file=sys.stderr)
            return 2
        backend = MAC.MacOSLiveBackend(acknowledged=a.i_have_a_backup, mount_point=a.mount_point,
                                       bless=a.bless) if a.live else None
        if a.revert:
            LP.revert(root, state, patch_id=a.id, backend=backend, on_event=printer(level))
            return 0
        if not a.overlays:
            print('hao: no overlays given', file=sys.stderr)
            return 2
        overlays = [LP.load_overlay(o) for o in a.overlays]
        deferred = deferred_entries(a)
        mode = 'installer' if a.installer else 'live'
        if a.dry_run:
            emit = printer(level)
            if backend:
                for problem in backend.inspect():
                    emit({'ev': 'warning', 'text': 'a live patch would be refused: ' + problem})
                p = LP.plan(overlays, root, mode, backend.attributes(root), resolve=backend.booted_path,
                            classify=backend.classifier(root))
            else:
                p = LP.plan(overlays, root, mode, classify=LP.Classifier(root) if mode == 'live' else None)
            emit(LP.plan_event(p))
            for row in p['write']:
                print('  %-6s %-22s %s' % ('new' if row['old_sha256'] is None else 'write', row['pack'], row['path']))
            for row in p['attrs']:
                print('  %-6s %-22s %s  (%s)' % ('attrs', row['pack'], row['path'], ', '.join(row['attrs'])))
            classify = backend.classifier(root) if backend else LP.Classifier(root)
            for ev in LP.deferred_report(deferred, {m['pack']: m['phase'] for m in overlays}, classify,
                                         bool(p['write'])):
                emit(ev)
            return 0
        LP.apply(overlays, root, state, mode=mode, backend=backend, on_event=printer(level), deferred=deferred)
        return 0
    except LP.PatchError as x:
        print('hao patch: %s' % x, file=sys.stderr)
        return 1


def guarded(fn, log=None):
    """Run FN(a, console); a Stopped check prints its report and exits 1. With LOG (a command name) the console's
    events are kept as that command's log (src/report.py), which hao report attaches."""
    def run(a):
        c = CON.Console(CON.level_of(a))
        v = REP.version()
        c.release = v.get('release') or dev_label(v.get('commit'))
        if log:
            c.run = PROG.Runner(c, log)
            hook_backends(a, c)
            finish_line(c, log)
            if log in ('install', 'build-disk'):
                c.column = 78                 # the mockups' install layout: P(text, 76) after the indent
            elif log == 'create-installer':
                c.column, c.gap = 60, True    # P(text, 58), a blank line between steps
                c.hide = ('hao makes a USB installer',)   # the backend's intro: the mockups open with the header
        try:
            refusal = None if getattr(a, 'dry_run', False) or os.environ.get('HAO_ANYWHERE') else \
                FD.wrong_place(getattr(a, 'action', None), FD.where())
            if refusal:
                raise CON.Stopped(refusal, untouched='nothing was done', code=5)
            return fn(a, c)
        except CON.Stopped as x:
            if getattr(c, 'run', None) is not None:
                c.run.explain(x)
            if log and INST.REPORT not in x.options and x.what != 'not confirmed' and x.code != 5:
                x.options.append(INST.REPORT)
            c.stopped(x)
            return FD.code_of(x)
        except (LP.PatchError, DETECT.DetectError) as x:
            c.stopped(CON.Stopped(str(x), options=[INST.REPORT] if log else ()))
            return 1
        except KeyboardInterrupt:
            c.event('interrupted')
            print('\nstopped: Control-C pressed', file=sys.stderr)
            return 130
        except BaseException as x:
            c.event('crash', error='%s: %s' % (type(x).__name__, x))
            raise
        finally:
            if log:
                REP.save_log(log, sys.argv[1:], c.events)
    return run


def dev_label(described):
    """"dev 73b28ae2" (and "+" when the checkout has changes) from git describe's "v0.1.0-alpha.1-78-g73b28ae2e743"."""
    if not described:
        return None
    import re
    m = re.search(r'(?:^|-g)([0-9a-f]{7,})(-dirty)?$', described)
    return 'dev %s%s' % (m.group(1)[:8], '+' if m.group(2) else '') if m else 'dev ' + described


def hook_backends(a, c, build=BUILD, inst=INST):
    """The console's view of the backends, set from here so their modules stay as builder writes them: every
    command they run goes through c.run (its output to the log, steps on screen, src/progress.py); the pack of each
    recipe comes from resolve(); the step plan is listed before the question only with --dry-run or --show."""
    resolve, show_steps, prepare_kit = (getattr(build.resolve, 'original', build.resolve),
                                        getattr(build.show_steps, 'original', build.show_steps),
                                        getattr(inst.prepare_kit, 'original', inst.prepare_kit))

    def resolve_hook(a2, c2, command):
        c2.muted = c2.level != 'json'          # the header below replaces resolve's own (events are still kept)
        try:
            out = resolve(a2, c2, command)
        finally:
            c2.muted = False
        if getattr(c2, 'run', None) is not None:
            c2.run.groups, c2.run.asm = out[3], out[2]
        header(c2, command, out[0], out[2])
        return out

    def show_steps_hook(c2, command, groups):
        if getattr(a, 'dry_run', False) or c2.at('files') or command not in ('install', 'build-disk'):
            return show_steps(c2, command, groups)
        c2.event('plan', command=command, steps=list(build.STEPS[command]))

    def prepare_kit_hook(a2, c2, path, run=None):
        return prepare_kit(a2, c2, path, run=run or getattr(c2, 'run', None) or subprocess.call)
    stick = getattr(inst, 'STICK', None)
    write = getattr(getattr(stick, 'write', None), 'original', getattr(stick, 'write', None))

    def write_hook(*args, on_step=None, **kw):
        """The stick's parts, each on a live line while it is written (the kit takes minutes)."""
        parts = iter(STICK_PARTS)
        live = [c.task('  ' + next(parts))]

        def told(text):
            live[0].drop()
            (on_step or (lambda t: None))(text)
            live[0] = c.task('  ' + next(parts, 'finish'))
        try:
            out = write(*args, on_step=told, **kw)
        except BaseException:
            live[0].end(False)
            raise
        live[0].drop()
        return out
    hooks = [(resolve_hook, resolve), (show_steps_hook, show_steps), (prepare_kit_hook, prepare_kit)]
    if write is not None:
        hooks.append((write_hook, write))
        stick.write = write_hook
    for fn, orig in hooks:
        fn.original = orig
    build.resolve, build.show_steps, inst.prepare_kit = resolve_hook, show_steps_hook, prepare_kit_hook


def header(c, command, profile, asm):
    """The mockups' header: the program and release, then this Mac (or the host) and the packs, in columns."""
    proven = profile.get('proven_model')
    build = 'macOS 27 %s' % asm.get('golden_build', '')
    title = {'install': 'hao installer', 'build-disk': 'hao installer'}.get(command, 'hao-builder')
    short = lambda n: (n or '').replace('Graphics ', '').split(' (')[0]   # "Intel HD 4000", as the mockups
    gpu = ', '.join(short(d.get('name') or d.get('device')) for d in profile.get('gpu', [])) or \
        short(profile.get('gpu_name'))
    check = ('proven model ' + c.ok) if proven else c.paint('warn', 'not proven on this model')
    if command not in ('install', 'build-disk'):
        # the mockups' builder header: "hao-builder 27.2.1-26B131.4   proven on MacBookPro9,2", then the host
        c.print(CON.at_column('%s %s' % (title, c.paint('bold', c.release or '')), 30) +
                ('proven on %s' % profile['model'] if proven else c.paint('warn', 'for %s, not proven' % profile['model'])))
        c.print('%-6s%s' % ('host', host_line(c)))
        c.print('%-7s%s' % ('Packs', ' · '.join(profile.get('packs', []))), 'files')
        c.event('header', command=command, model=profile.get('model'), packs=profile.get('packs'))
        return
    c.print('%s %s  %s' % (title, c.paint('bold', c.release or ''), c.paint('dim', build)) if c.release else
            '%s  %s' % (title, c.paint('dim', build)))
    if command in ('install', 'build-disk'):
        try:
            mem = ('%d GB' % profile['memory_gb'] if profile['memory_gb'] else '') if 'memory_gb' in profile else \
                '%d GB' % round(os.sysconf('SC_PHYS_PAGES') * os.sysconf('SC_PAGE_SIZE') / 2.0 ** 30)
        except (ValueError, OSError):
            mem = ''
        c.print(CON.at_column('%-7s%s' % ('Mac', ' · '.join(x for x in (profile['model'], gpu, mem) if x)), 67) + check)
    else:
        c.print(CON.at_column('%-7s%s' % ('For', ' · '.join(x for x in (profile['model'], gpu) if x)), 67) + check)
        c.print('%-7s%s' % ('host', host_line(c)))
    c.print('%-7s%s' % ('Packs', ' · '.join(profile.get('packs', []))))
    detection(c, profile)
    c.event('header', command=command, model=profile.get('model'), packs=profile.get('packs'))


def detection(c, profile, packs_dir=REPO / 'packs'):
    """--show-edits: the mockups' detection table, one row per pack: what on this Mac chose it (a device and the OCLP
    patch set it gets, the board id, or any Intel Mac) -> the pack."""
    if not c.at('edits'):
        return
    have = profile.get('oclp_patchsets') or []
    gpu = profile.get('gpu_name') or ', '.join(d.get('name', '') for d in profile.get('gpu', []))
    names = {'audio': ', '.join(d.get('name', '') for d in profile.get('audio', [])) or 'HDA codec',
             'wifi': ', '.join(d.get('name', '') for d in profile.get('wifi', [])) or 'Wi-Fi card'}
    rows = []
    for pack in profile.get('packs', []):
        try:
            rule = json.loads((Path(packs_dir) / (pack + '.json')).read_text()).get('detect', {})
        except (OSError, ValueError):
            continue
        sets = [x for x in rule.get('oclp_patchsets', []) if x in have]
        if sets:
            role = 'Audio' if 'Audio' in sets[0] else 'Wi-Fi' if 'Wireless' in sets[0] else 'GPU'
            device = names['audio'] if role == 'Audio' else names['wifi'] if role == 'Wi-Fi' else gpu
            rows.append((role, device, sets[0], pack))
        elif rule.get('board_ids'):
            rows.append(('Board', profile.get('board_id') or '', profile.get('model', ''), pack))
        elif rule.get('any_intel'):
            rows.append(('CPU', 'Intel', 'any Intel', pack))
    if not rows:
        return
    c.print('', 'edits')
    c.print(c.paint('bold', 'Detect hardware') + '  ' + c.paint('dim', 'OCLP-style: device → patch set → pack'), 'edits')
    for role, device, via, pack in rows:
        c.print('  %-8s%-30s%-28s→ %s' % (role, device.replace('Graphics ', '').split(' (')[0][:28], '→ ' + via,
                                         c.paint('bold', pack)), 'edits')


def host_line(c):
    """macOS 26.7 · Apple silicon · Xcode 26.1 ✓ · 1,369 GB free ✓ (the mockups' host line)."""
    import platform
    import shutil
    mac = platform.mac_ver()[0]
    arch = 'Apple silicon' if platform.machine() == 'arm64' else 'Intel'
    try:
        free = '%s GB free %s' % (format(shutil.disk_usage(str(CACHE.parent if CACHE.parent.exists() else Path.home()))
                                         .free // 10 ** 9, ','), c.ok)
    except OSError:
        free = ''
    xcode = ''
    try:
        r = subprocess.run(['xcodebuild', '-version'], capture_output=True, text=True, timeout=20)
        if r.returncode == 0 and r.stdout.startswith('Xcode'):
            xcode = '%s %s' % (r.stdout.split('\n')[0], c.ok)
    except (OSError, subprocess.SubprocessError):
        pass
    xcode = xcode or c.paint('warn', 'no Xcode (needed for the Metal libraries)')
    return ' · '.join(x for x in ('macOS ' + mac if mac else '', arch, xcode, free) if x)


def finish_line(c, command):
    """Replace the backends' last line with the mockups' ("Installed ... in 41m 18s · ...", "Done in ...")."""
    done = c.done

    def wrapped(text, **fields):
        took = CON.elapsed(c.clock() - c.started)
        log = getattr(getattr(c, 'run', None), 'log', None)
        more = ['Log: %s' % log] if log else []
        if command in ('install', 'build-disk') and 'installed on' in text and c.level == 'quiet':
            return done('Installed in %s. Details are in the log%s.' % (took, ': %s' % log if log else ''), **fields)
        if command in ('install', 'build-disk') and 'installed on' in text:
            disk = text.split('installed on ', 1)[1].split(';')[0]
            s = getattr(c.run, 'summary', {}) if getattr(c, 'run', None) else {}
            parts = ['macOS 27 on %s in %s' % (disk, took)]
            if s.get('files'):
                parts.append('%s files from packs' % format(s['files'], ','))
            if s.get('edits'):
                parts.append('%s edits' % format(s['edits'], ','))
            if s.get('repairs'):
                parts.append('%d kernel repairs' % s['repairs'])
            parts.append('no notes' if not s.get('notes') else '%d notes' % s['notes'])
            return done(' · '.join(parts), lead=c.paint('ok', 'Installed'), more=more + ['Restart to use it.'],
                        **fields)
        if command == 'create-installer' and not text.startswith('dry run'):
            text = text.replace('USB stick', 'USB installer').replace('stick image', 'USB installer image')
            return done('in %s. %s' % (took, text[:1].upper() + text[1:]), lead=c.paint('ok', 'Done'), more=more,
                        **fields)
        return done(text, **fields)
    c.done = wrapped


