def cmd_assets(a, c):
    path, _ = BUILD.assembly(a.assembly, BUILD.mac(a))
    store = Path(a.store).expanduser().resolve() if a.store else (BUILD.TOP / 'store').resolve()
    if a.op == 'make':
        made = ASSETS.make(a.folder, path, store)
        for what, where in made:
            c.item('%-34s %s' % (what, where), 'files')
        c.done('%d inputs and tools in %s' % (len(made), a.folder))
        return 0
    problems = ASSETS.check(path, Path(a.folder).expanduser().resolve(), here=a.here)
    for p in problems:
        c.item(p, 'quiet', ev='asset.problem', problem=p)
    if problems:
        raise CON.Stopped('%d inputs are missing or wrong' % len(problems))
    c.done('every input present with its pinned hash')
    return 0


