	UTOF r12.x, r11.x;
	FMUL r13.x, r12.x, 0x3B808081;
	IADD r14.x, r4.x, 2;
	AND r15.x, r14.x, 3;
	SHL r16.x, r15.x, 3;
	AND r17.x, r14.x, -4;
	LD_RAW r18, r17.x, C-1;
