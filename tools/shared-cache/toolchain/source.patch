-struct JSONHeader
-{
-    uint64_t            version;
-    PlatformAndVersions pvs;
-    Architecture        arch;
-    std::string         installName;
-    std::string         options;
-    const Node*         atoms=nullptr;
-    const Node*         dylibs=nullptr;
-    const Node*         customSections=nullptr;
-};
